def smallCoordIndex (p : Coord 3 3 5) : Fin 45 :=
  ⟨(p.1.1.val * 3 + p.1.2.val) * 5 + p.2.val, by omega⟩

def smallParamIndex (t : Param 3 3 5) : Fin 55 :=
  ⟨t.1.val * 11 + (match t.2 with
    | Sum.inl i => i.val
    | Sum.inr (Sum.inl j) => 3 + j.val
    | Sum.inr (Sum.inr k) => 6 + k.val), by
      rcases t with ⟨t, i | (j | k)⟩
      · change t.val * 11 + i.val < 55; omega
      · change t.val * 11 + (3 + j.val) < 55; omega
      · change t.val * 11 + (6 + k.val) < 55; omega⟩

